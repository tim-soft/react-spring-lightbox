{
    "name": "react-spring-lightbox",
    "version": "1.10.0",
    "description": "A flexible image gallery lightbox with native-feeling touch gestures and buttery smooth animations, built with react-spring.",
    "author": "Tim Ellenberger <timellenberger@gmail.com>",
    "license": "MIT",
    "repository": "tim-soft/react-spring-lightbox",
    "sideEffects": false,
    "bugs": {
        "url": "https://github.com/tim-soft/react-spring-lightbox/issues"
    },
    "homepage": "https://timellenberger.com",
    "keywords": [
        "react",
        "spring",
        "lightbox",
        "modal",
        "gallery",
        "touch",
        "gestures",
        "images"
    ],
    "type": "commonjs",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
        "npm": ">=10.9.0"
    },
    "scripts": {
        "fix": "npm run fix:oxlint && npm run fix:oxfmt",
        "fix:oxfmt": "oxfmt --write",
        "fix:oxlint": "oxlint --fix",
        "lint": "npm run lint:oxlint && npm run lint:oxfmt && npm run lint:ts && npm run lint:package",
        "lint:oxfmt": "oxfmt --check",
        "lint:oxlint": "oxlint",
        "lint:package": "publint && attw --pack .",
        "lint:ts": "npx tsc --noEmit -p . && npx tsc --noEmit -p e2e",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "build": "rolldown --config rolldown.config.mjs",
        "start": "rolldown --config rolldown.config.mjs --watch",
        "prepare": "husky && npm run build",
        "ch": "changeset",
        "ch:version": "changeset version && node scripts/add-release-dates.mjs",
        "ch:publish": "changeset publish"
    },
    "lint-staged": {
        "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
            "oxlint --fix --no-error-on-unmatched-pattern",
            "oxfmt --write --no-error-on-unmatched-pattern"
        ],
        "*.{json,jsonc,md,yml,yaml,css,html}": "oxfmt --write --no-error-on-unmatched-pattern"
    },
    "peerDependencies": {
        "react": ">=16.8",
        "react-dom": ">=16.8"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@changesets/cli": "^3.0.3",
        "@playwright/test": "^1.65.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "~7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.0",
        "lint-staged": "^17.6.0",
        "monocart-coverage-reports": "^3.2.0",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "oxlint-tsgolint": "7.0.2006",
        "publint": "0.3.25",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rolldown": "~1.3.0",
        "rolldown-plugin-dts": "^0.30.0",
        "typescript": "7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "MIGRATION.md"
    ],
    "dependencies": {
        "@react-spring/web": "^10.1.2",
        "@use-gesture/react": "^10.3.1"
    }
}
