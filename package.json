{
    "name": "react-spring-lightbox",
    "version": "1.9.0",
    "description": "A flexible image gallery lightbox with native-feeling touch gestures and buttery smooth animations, built with react-spring.",
    "author": "Tim Ellenberger <timellenberger@gmail.com>",
    "license": "MIT",
    "repository": "tim-soft/react-spring-lightbox",
    "sideEffects": false,
    "bugs": {
        "url": "https://github.com/tim-soft/react-spring-lightbox/issues"
    },
    "homepage": "https://timellenberger.com",
    "keywords": [
        "react",
        "spring",
        "lightbox",
        "modal",
        "gallery",
        "touch",
        "gestures",
        "images"
    ],
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts",
    "engines": {
        "node": ">=16",
        "npm": ">=7"
    },
    "scripts": {
        "fix": "npm run fix:oxlint && npm run fix:oxfmt",
        "fix:oxfmt": "oxfmt --write",
        "fix:oxlint": "oxlint --fix",
        "lint": "npm run lint:oxlint && npm run lint:oxfmt && npm run lint:ts",
        "lint:oxfmt": "oxfmt --check",
        "lint:oxlint": "oxlint",
        "lint:ts": "npx tsc --noEmit -p . && npx tsc --noEmit -p e2e",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "build": "rolldown --config rolldown.config.mjs && npm run build:types",
        "build:types": "tsc --project tsconfig.buildtypes.json --emitDeclarationOnly",
        "start": "rolldown --config rolldown.config.mjs --watch",
        "prepare": "npm run build",
        "ch": "changeset",
        "ch:version": "changeset version && node scripts/add-release-dates.mjs",
        "ch:publish": "changeset publish"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
            "oxlint --fix --no-error-on-unmatched-pattern",
            "oxfmt --write --no-error-on-unmatched-pattern"
        ],
        "*.{json,jsonc,md,yml,yaml,css,html}": "oxfmt --write --no-error-on-unmatched-pattern"
    },
    "peerDependencies": {
        "react": ">=16.8",
        "react-dom": ">=16.8"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@playwright/test": "^1.65.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "~6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^7.0.3",
        "husky": "^4.3.8",
        "jsdom": "^31.0.0",
        "lint-staged": "^10.5.4",
        "monocart-coverage-reports": "^3.2.0",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-is": "^19.3.1",
        "rolldown": "~1.2.16",
        "typescript": "7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@react-spring/web": "^10.1.2",
        "react-use-gesture": "9.1.3"
    },
    "allowScripts": {
        "husky@4.3.8": true
    }
}
